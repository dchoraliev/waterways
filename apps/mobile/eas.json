{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "autoIncrement": "buildNumber"
      }
    },
    "development_sandbox": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "autoIncrement": "buildNumber"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
