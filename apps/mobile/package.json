{
  "name": "@waterways/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "run:android": "expo run:android",
    "install:debug": "cd android && ./gradlew installDebug",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "check:release-config": "node ./scripts/check-release-config.js",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-voice/voice": "^3.2.1",
    "@waterways/shared": "*",
    "assert": "^2.1.0",
    "expo": "~54.0.34",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "^8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-speech-recognition": "^3.1.3",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "lucide-react-native": "^0.553.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "glob": "11.1.0",
    "js-yaml": "4.1.1",
    "node-forge": "1.3.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-voice/voice"
        ]
      }
    }
  },
  "private": true
}
