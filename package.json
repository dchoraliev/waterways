{
  "name": "waterways-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "scripts": {
    "mobile": "yarn workspace @waterways/mobile start",
    "mobile:expo-config": "cd apps/mobile && node ../../node_modules/expo/bin/cli config --type public",
    "mobile:eas:build:ios:development": "cd apps/mobile && cross-env EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli build -p ios --profile development",
    "mobile:eas:build:ios:dev-device": "cd apps/mobile && cross-env EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli build --non-interactive -p ios --profile development",
    "mobile:eas:build:ios:sandbox": "cd apps/mobile && cross-env APP_VARIANT=sandbox APP_DISPLAY_NAME=\"Waterways Sandbox\" IOS_BUNDLE_ID=com.waterways.mobile.sandbox EXPO_SCHEME=waterways-sandbox EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli build --non-interactive -p ios --profile development_sandbox",
    "mobile:eas:build:ios": "cd apps/mobile && cross-env EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli build -p ios --profile production",
    "mobile:eas:build:ios:ci": "cd apps/mobile && cross-env EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli build --non-interactive -p ios --profile production",
    "mobile:eas:build:testflight": "cd apps/mobile && eas build --platform ios --profile production --auto-submit",
    "web": "cross-env VITE_CJS_IGNORE_WARNING=true yarn workspace @waterways/web dev",
    "build:shared": "yarn workspace @waterways/shared build",
    "types:generate": "npx supabase gen types typescript --project-id gvitbturpeirneatzagn > packages/shared/src/models/database-types.ts",
    "db:link": "npx supabase link --project-ref gvitbturpeirneatzagn",
    "db:migration:new": "npx supabase migration new",
    "db:migration:list": "npx supabase migration list",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:function:new": "npx supabase functions new",
    "db:function:deploy": "npx supabase functions deploy",
    "db:function:serve": "npx supabase functions serve",
    "db:function:logs": "npx supabase functions logs",
    "test": "jest",
    "test:mobile": "jest --selectProjects mobile",
    "test:web": "jest --selectProjects web",
    "test:shared": "jest --selectProjects shared",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npx eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "npx eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "npx prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx,json}\"",
    "format:check": "npx prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx,json}\"",
    "type-check": "yarn workspace @waterways/mobile type-check && yarn workspace @waterways/web type-check && yarn workspace @waterways/shared type-check",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^7.0.3",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^6.5.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.0",
    "supabase": "^2.98.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "better-sqlite3": "^12.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-vector-icons": "^10.3.0"
  },
  "overrides": {
    "js-yaml": "4.1.1",
    "node-forge": "1.3.2"
  }
}
