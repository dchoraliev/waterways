{
  "name": "waterways-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "scripts": {
    "mobile": "yarn workspace @waterways/mobile start",
    "web": "yarn workspace @waterways/web web",
    "build:shared": "yarn workspace @waterways/shared build",
    "types:generate": "npx supabase gen types typescript --project-id gvitbturpeirneatzagn > packages/shared/src/models/database-types.ts",
    "db:link": "npx supabase link --project-ref gvitbturpeirneatzagn",
    "db:migration:new": "npx supabase migration new",
    "db:migration:list": "npx supabase migration list",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull",
    "db:function:new": "npx supabase functions new",
    "db:function:deploy": "npx supabase functions deploy",
    "db:function:serve": "npx supabase functions serve",
    "db:function:logs": "npx supabase functions logs",
    "test": "jest",
    "test:mobile": "jest --selectProjects mobile",
    "test:web": "jest --selectProjects web",
    "test:shared": "jest --selectProjects shared",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npx eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "npx eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "npx prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx,json}\"",
    "format:check": "npx prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit && yarn workspace @waterways/mobile type-check && yarn workspace @waterways/web type-check && yarn workspace @waterways/shared type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "prettier": "^3.6.2",
    "supabase": "^2.58.5",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "overrides": {
    "js-yaml": "4.1.1",
    "node-forge": "1.3.2"
  }
}
