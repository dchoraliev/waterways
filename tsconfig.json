{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "dom"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@waterways/shared/*": [
        "packages/shared/*"
      ],
      "@shared/*": [
        "packages/shared/src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  }
}
